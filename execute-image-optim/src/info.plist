				<key>script</key>
				<string>use framework "Foundation"
use scripting additions

on t(ja, en)
	set lang to system attribute "language"
	if lang is "ja" then return ja
	if lang is "en" then return en
	set preferred to (current application's NSLocale's preferredLanguages()'s firstObject()) as text
	if preferred is "ja" or preferred starts with "ja-" then return ja
	return en
end t

on run argv
	tell application "System Events" to set frontApp to name of first process whose frontmost is true
	set targets to {}
	if frontApp is "Path Finder" then
		tell application "Path Finder"
			try
				repeat with anItem in (get selection)
					set end of targets to POSIX path of anItem
				end repeat
			end try
			if targets is {} then
				try
					set end of targets to POSIX path of target of front finder window
				end try
			end if
		end tell
	else if frontApp is "Finder" then
		tell application "Finder"
			repeat with anItem in (get selection)
				set end of targets to POSIX path of (anItem as alias)
			end repeat
			if targets is {} and (count of Finder windows) &gt; 0 then set end of targets to POSIX path of (target of front Finder window as alias)
		end tell
	end if
	if targets is {} then return my t("FinderまたはPath Finderで画像を選択するか、フォルダを開いてください", "Select images or open a folder in Finder or Path Finder")
	try
		do shell script "open -Ra ImageOptim"
	on error
		return my t("ImageOptimが見つかりません", "ImageOptim not found")
	end try
	set command to "open -a ImageOptim"
	repeat with targetPath in targets
		set command to command &amp; " " &amp; quoted form of targetPath
	end repeat
	do shell script command
end run</string>
