{
  "bundleid": "com.31mskz10.LaunchApplications.ui",
  "log": {
    "internal": true,
    "level": "error"
  },
  "variablesconfig": {
    "language": {
      "src": "variable",
      "default": "auto",
      "scriptenv": true
    },
    "restore_timeout": {
      "src": "variable",
      "default": "20",
      "scriptenv": true
    },
    "query": {
      "src": "args[0]",
      "default": ""
    },
    "groups": {
      "default": "",
      "persist": true,
      "scriptenv": true
    },
    "draft": {
      "default": "[]",
      "scriptenv": true
    },
    "pinned": {
      "default": "[]",
      "scriptenv": true
    }
  },
  "window": {
    "title": "Application Group",
    "size": {
      "width": 600,
      "height": 480
    },
    "minsize": {
      "width": 480,
      "height": 320
    },
    "padding": 16,
    "root": {
      "type": "view",
      "layout": "border",
      "spacing": 12,
      "events": [
        {
          "triggers": "preload",
          "action": {
            "type": "script",
            "src": "groups.js",
            "args": [
              "load"
            ]
          }
        }
      ],
      "shortcuts": [
        {
          "shortcut": "↑",
          "action": {
            "type": "function",
            "src": "groups",
            "args": "selectup"
          }
        },
        {
          "shortcut": "↓",
          "action": {
            "type": "function",
            "src": "groups",
            "args": "selectdown"
          }
        },
        {
          "shortcut": "⇧↩",
          "action": {
            "type": "script",
            "src": "groups.js",
            "args": [
              "launch",
              "{value:groups.selected.groupId.text}",
              "plain"
            ]
          }
        },
        {
          "shortcut": "⌘N",
          "action": {
            "type": "script",
            "src": "groups.js",
            "args": [
              "edit"
            ]
          }
        },
        {
          "shortcut": "⌘E",
          "action": {
            "type": "script",
            "src": "groups.js",
            "args": [
              "edit",
              "{value:groups.selected.groupId.text}"
            ]
          }
        },
        {
          "shortcut": "⌘⌫",
          "action": {
            "type": "script",
            "src": "groups.js",
            "args": [
              "confirm",
              "{value:groups.selected.groupId.text}"
            ]
          }
        },
        {
          "shortcut": "⌘L",
          "action": {
            "type": "script",
            "src": "groups.js",
            "args": [
              "record",
              "{value:groups.selected.groupId.text}"
            ]
          }
        }
      ],
      "components": [
        {
          "type": "textfield",
          "id": "search",
          "constraints": {
            "region": "top"
          },
          "focus": true,
          "text": "{var:query}",
          "font": {
            "size": 15
          },
          "events": [
            {
              "triggers": "changed",
              "action": {
                "type": "function",
                "src": "groups",
                "args": "filterdata"
              }
            },
            {
              "triggers": "actioned",
              "action": {
                "type": "script",
                "src": "groups.js",
                "args": [
                  "launch",
                  "{value:groups.selected.groupId.text}"
                ]
              }
            }
          ]
        },
        {
          "type": "dataview",
          "id": "groups",
          "constraints": {
            "region": "centre"
          },
          "cols": 1,
          "spacing": 2,
          "padding": 4,
          "placeholder": "",
          "data": {
            "src": []
          },
          "events": [
            {
              "triggers": "doubleclicked",
              "action": {
                "type": "script",
                "src": "groups.js",
                "args": [
                  "launch",
                  "{value:groups.selected.groupId.text}"
                ]
              }
            },
            {
              "triggers": "changed",
              "action": {
                "type": "json",
                "src": {
                  "update": {
                    "ids": {
                      "status": {
                        "text": "",
                        "tooltip": ""
                      }
                    }
                  }
                }
              }
            }
          ],
          "cell": {
            "height": 52,
            "init": {
              "groupCell.background": null,
              "groupName.colour": "labelColor",
              "groupApps.colour": "secondaryLabelColor"
            },
            "selected": {
              "groupCell.background": "alfredSelectedResultBackgroundColor",
              "groupName.colour": "alfredSelectedResultTextColor",
              "groupApps.colour": "alfredSelectedResultTextColor"
            },
            "root": {
              "type": "view",
              "id": "groupCell",
              "layout": "border",
              "spacing": 10,
              "padding": 8,
              "cornerradius": 6,
              "components": [
                {
                  "type": "label",
                  "id": "groupId",
                  "hidden": true
                },
                {
                  "type": "imageview",
                  "id": "groupIcon",
                  "constraints": {
                    "region": "left",
                    "size": 32
                  }
                },
                {
                  "type": "view",
                  "layout": "inline",
                  "direction": "vertical",
                  "spacing": 2,
                  "constraints": {
                    "region": "centre"
                  },
                  "components": [
                    {
                      "type": "label",
                      "text": "",
                      "font": {
                        "size": 13,
                        "weight": "medium"
                      },
                      "id": "groupName",
                      "linebreak": "truncatetail"
                    },
                    {
                      "type": "label",
                      "text": "",
                      "font": {
                        "size": 11
                      },
                      "id": "groupApps",
                      "linebreak": "truncatetail"
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "type": "view",
          "layout": "border",
          "spacing": 8,
          "constraints": {
            "region": "bottom"
          },
          "components": [
            {
              "type": "view",
              "layout": "inline",
              "direction": "horizontal",
              "spacing": 8,
              "components": [
                {
                  "type": "button",
                  "id": "addButton",
                  "text": "+",
                  "events": [
                    {
                      "triggers": "actioned",
                      "action": {
                        "type": "script",
                        "src": "groups.js",
                        "args": [
                          "edit"
                        ]
                      }
                    }
                  ]
                },
                {
                  "type": "button",
                  "id": "removeButton",
                  "text": "−",
                  "events": [
                    {
                      "triggers": "actioned",
                      "action": {
                        "type": "script",
                        "src": "groups.js",
                        "args": [
                          "confirm",
                          "{value:groups.selected.groupId.text}"
                        ]
                      }
                    }
                  ]
                },
                {
                  "type": "button",
                  "id": "editButton",
                  "text": "",
                  "events": [
                    {
                      "triggers": "actioned",
                      "action": {
                        "type": "script",
                        "src": "groups.js",
                        "args": [
                          "edit",
                          "{value:groups.selected.groupId.text}"
                        ]
                      }
                    }
                  ]
                },
                {
                  "type": "button",
                  "id": "recordButton",
                  "text": "",
                  "events": [
                    {
                      "triggers": "actioned",
                      "action": {
                        "type": "script",
                        "src": "groups.js",
                        "args": [
                          "record",
                          "{value:groups.selected.groupId.text}"
                        ]
                      }
                    }
                  ]
                }
              ],
              "constraints": {
                "region": "left"
              }
            },
            {
              "type": "label",
              "text": "",
              "font": {
                "size": 11
              },
              "id": "status",
              "colour": "secondaryLabelColor",
              "linebreak": "truncatetail",
              "constraints": {
                "region": "centre"
              }
            },
            {
              "type": "button",
              "id": "launchButton",
              "text": "",
              "events": [
                {
                  "triggers": "actioned",
                  "action": {
                    "type": "script",
                    "src": "groups.js",
                    "args": [
                      "launch",
                      "{value:groups.selected.groupId.text}"
                    ]
                  }
                }
              ],
              "constraints": {
                "region": "right"
              }
            }
          ]
        }
      ]
    }
  }
}
