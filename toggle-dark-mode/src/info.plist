	<key>objects</key>
	<array>
		<dict>
			<key>config</key>
			<dict>
				<key>applescript</key>
				<string>on alfred_script(q)
  try
    tell application "System Events"
      tell appearance preferences
        if q is "dark" or q is "light" then
          set dark mode to (q is "dark")
        else
          set dark mode to not dark mode
        end if
      end tell
    end tell
  on error errMsg
    display notification errMsg with title "Toggle Dark Mode"
  end try
end alfred_script</string>
