				<string>use framework "Foundation"
use scripting additions

on t(ja, en)
	set lang to system attribute "language"
	if lang is "ja" then return ja
	if lang is "en" then return en
	set preferred to (current application's NSLocale's preferredLanguages()'s firstObject()) as text
	if preferred is "ja" or preferred starts with "ja-" then return ja
	return en
end t

on failure(errMsg, errNum)
	if errNum is -1743 then return my t("オートメーションの許可が必要です。システム設定 &gt; プライバシーとセキュリティ &gt; オートメーション で Alfred に Finder・Path Finder・System Events の制御を許可してください。", "Automation access is required. Allow Alfred to control Finder, Path Finder and System Events in System Settings &gt; Privacy &amp; Security &gt; Automation.")
	return my t("開けませんでした: ", "Could not open: ") &amp; errMsg
end failure

on targetPaths()
	set saved to (current application's NSProcessInfo's processInfo()'s environment()'s objectForKey:"owa_targets")
	if saved is not missing value then
		if (saved as text) is not "" then
			set savedData to saved's dataUsingEncoding:(current application's NSUTF8StringEncoding)
			set parsed to current application's NSJSONSerialization's JSONObjectWithData:savedData options:0 |error|:(missing value)
			if parsed is not missing value then return parsed as list
		end if
	end if
	set found to {}
	set pathFinder to "Path Finder"
	tell application "System Events" to set frontApp to name of first process whose frontmost is true
	if frontApp is pathFinder then
		tell application pathFinder
			set sel to (get «property slcT»)
			if sel is missing value then set sel to {}
			repeat with anItem in sel
				set end of found to «property pthP» of anItem
			end repeat
			if found is {} then
				try
					set end of found to «property pthP» of «property tarG» of «class fwiD» 1
				end try
			end if
		end tell
	else
		tell application "Finder"
			repeat with anItem in (get selection)
				set end of found to POSIX path of (anItem as alias)
			end repeat
			if found is {} then
				try
					set end of found to POSIX path of (target of front Finder window as alias)
				end try
			end if
		end tell
	end if
	if found is {} then
		if (system attribute "default_folder") is "desktop" then
			set end of found to POSIX path of (path to desktop folder)
		else
			set end of found to POSIX path of (path to home folder)
		end if
	end if
	return found
end targetPaths

on openPaths(appArg, paths)
	set appPath to (POSIX file appArg) as alias
	set theTarget to {}
	repeat with targetPath in paths
		set end of theTarget to ((POSIX file (targetPath as text)) as alias)
	end repeat
	tell application "Finder" to open theTarget using appPath
end openPaths

on run argv
	try
		my openPaths(item 1 of argv, my targetPaths())
	on error errMsg number errNum
		return my failure(errMsg, errNum)
	end try
	return ""
end run
